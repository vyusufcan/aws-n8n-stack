#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io curl nginx unzip
systemctl enable --now docker
usermod -aG docker ubuntu

curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip awscliv2.zip
./aws/install
rm -rf aws awscliv2.zip

TOKEN="$(curl -fsSL -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600')"
AWS_REGION="$(curl -fsSL -H "X-aws-ec2-metadata-token: $TOKEN" 'http://169.254.169.254/latest/meta-data/placement/region')"

DEVICE=""
DATA_MOUNT_PATH="${data_mount_path}"
N8N_FILE_PATH="/srv/data"

for _ in $(seq 1 60); do
  for candidate in "${data_device_name}" "/dev/xvdf" "/dev/nvme1n1"; do
    if [ -e "$candidate" ]; then
      resolved="$(readlink -f "$candidate")"
      if [ -b "$resolved" ]; then
        DEVICE="$resolved"
        break 2
      fi
    fi
  done

  sleep 2
done

if [ -z "$DEVICE" ]; then
  echo "Could not find attached EBS volume" >&2
  lsblk >&2 || true
  exit 1
fi

if ! blkid "$DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 -F "$DEVICE"
fi

mkdir -p "$DATA_MOUNT_PATH"
mkdir -p "$N8N_FILE_PATH"

UUID="$(blkid -s UUID -o value "$DEVICE")"
grep -q "$${UUID}" /etc/fstab || echo "UUID=$${UUID} $${DATA_MOUNT_PATH} ext4 defaults,nofail 0 2" >> /etc/fstab
mountpoint -q "$DATA_MOUNT_PATH" || mount "$DATA_MOUNT_PATH"
# Ensure an existing ext4 filesystem expands to fill a resized EBS volume.
resize2fs "$DEVICE"
chown -R 1000:1000 "$DATA_MOUNT_PATH"

KUBECONFIG_TARGET="$DATA_MOUNT_PATH/${k3s_kubeconfig_relative_path}"
mkdir -p "$(dirname "$KUBECONFIG_TARGET")"
rm -f "$KUBECONFIG_TARGET"

for _ in $(seq 1 90); do
  READY_IP="$(aws ssm get-parameter \
    --region "$AWS_REGION" \
    --name "${k3s_ready_parameter}" \
    --query 'Parameter.Value' \
    --output text 2>/dev/null || true)"

  if [ -z "$READY_IP" ]; then
    sleep 10
    continue
  fi

  KUBECONFIG_TMP="$(mktemp)"
  if aws ssm get-parameter \
    --region "$AWS_REGION" \
    --name "${k3s_kubeconfig_parameter}" \
    --query 'Parameter.Value' \
    --output text > "$KUBECONFIG_TMP" && grep -Fq "server: https://$READY_IP:6443" "$KUBECONFIG_TMP"; then
    if ! timeout 5 bash -c "</dev/tcp/$READY_IP/6443" >/dev/null 2>&1; then
      rm -f "$KUBECONFIG_TMP"
      sleep 10
      continue
    fi
    mv "$KUBECONFIG_TMP" "$KUBECONFIG_TARGET"
    chmod 600 "$KUBECONFIG_TARGET"
    chown 1000:1000 "$KUBECONFIG_TARGET"
    break
  fi
  rm -f "$KUBECONFIG_TMP"

  sleep 10
done

if [ ! -s "$KUBECONFIG_TARGET" ]; then
  echo "Could not retrieve k3s kubeconfig from SSM Parameter Store" >&2
  exit 1
fi

mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/n8n
mkdir -p /var/www/k8s-agent

printf '%s' '${chat_html_content_base64_gzip}' | base64 -d | gunzip > /var/www/k8s-agent/index.html

printf '%s' '${nginx_config_content_base64}' | base64 -d > /etc/nginx/sites-available/chat

rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/chat /etc/nginx/sites-enabled/chat
systemctl enable nginx
systemctl restart nginx

cat > /opt/n8n/docker-compose.yml <<'EOF'
services:
  n8n:
    image: vyusufcan/n8n:2.17.7
    container_name: n8n
    restart: unless-stopped
    ports:
      - "${n8n_host_port}:5678"
    environment:
      - N8N_HOST=${domain_name}
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - WEBHOOK_URL=https://${domain_name}/
      - N8N_EDITOR_BASE_URL=https://${domain_name}/
      - GENERIC_TIMEZONE=${n8n_timezone}
      - TZ=${n8n_timezone}
      - N8N_SECURE_COOKIE=true
      - N8N_ENCRYPTION_KEY=${n8n_encryption_key}
      - NODES_EXCLUDE=[]
      - NODE_FUNCTION_ALLOW_BUILTIN=*
      - NODE_FUNCTION_ALLOW_EXTERNAL=*
    volumes:
      - ${data_mount_path}:/home/node/.n8n
      - ${N8N_FILE_PATH}:/home/node/.n8n-files
EOF

cd /opt/n8n
docker compose up -d
